{
  "expo": {
    "name": "QuizTracker",
    "slug": "quiz-tracker",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "2",
      "supportsTablet": false,
      "bundleIdentifier": "com.remonedev.quiztracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1012"
      },
      "package": "com.dzem0r.quiztracker",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f6110326-4d91-472b-9daf-f1713a363e77"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0d1012"
        }
      ]
    ]
  }
}
